{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "outDir": "./build", // es para index.js
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true, // variables aren't read.
    "noUnusedParameters": true, // parameter isn't read.
    "exactOptionalPropertyTypes": true, // types as written, rather than adding 'undefined'.
    "noImplicitReturns": true, // codepaths that do not explicitly return in a function.
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  }
}
